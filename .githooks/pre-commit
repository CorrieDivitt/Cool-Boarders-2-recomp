#!/bin/sh
# Blocks commits containing anything from the game disc. Installed by tools/install_hooks.
PY=$(command -v python3 || command -v python || command -v py)
[ -n "$PY" ] || { echo "IP guard: Python not found, refusing to commit unchecked." >&2; exit 1; }
exec "$PY" "$(git rev-parse --show-toplevel)/tools/ip_guard.py" --staged
